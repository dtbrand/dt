{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dt",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "build": {
    "command": "node cloudflare/prepare-assets.mjs"
  },
  "assets": {
    "directory": "./cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dt-brands-db",
      "database_id": "e88559da-f892-4d67-819d-7ea81a8719ff"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "2d2d99c601bf4724862812d3e7ceb685"
    }
  ],
  "vars": {
    "ORIGIN_URL": "https://yourdomain.com"
  },
  "previews": {
    "vars": {
      "ORIGIN_URL": "https://yourdomain.com"
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "e88559da-f892-4d67-819d-7ea81a8719ff"
      }
    ],
    "kv_namespaces": [
      {
        "binding": "KV",
        "id": "2d2d99c601bf4724862812d3e7ceb685"
      }
    ]
  }
}
